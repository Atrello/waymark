# Copy this file to .env and fill it in. Never commit .env.

# --- Web server ---
PORT=3000
# 127.0.0.1 = only this PC (use with a reverse proxy / tunnel). 0.0.0.0 = whole network.
HOST=0.0.0.0
# The address people open the site at. Passkeys only work at this exact address (HTTPS, or localhost).
# If it is https://, sign-in cookies are marked Secure automatically.
APP_URL=http://localhost:3000
# Optional extra addresses allowed to sign in (comma separated), e.g. a LAN address.
TRUSTED_ORIGINS=

# --- First administrator (only used once, to create user "admin" (or ADMIN_USERNAME) when there are no users) ---
APP_PASSWORD=change-me-to-something-long
# Long random string (signs sessions, encrypts the saved Google key); generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Google (distance lookups only) ---
# Cloud Console: enable "Routes API", create an API key, restrict it to Routes API (+ your server IP).
GOOGLE_MAPS_API_KEY=

# --- Storage ---
DB_FILE=./data/waymark.db
BACKUP_DIR=./backups
